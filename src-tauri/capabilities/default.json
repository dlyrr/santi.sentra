{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Sentra main window. Deliberately scoped to \"main\" only: the roblox-login and roblox-browser windows load roblox.com, and a remote origin must never be granted Tauri command access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-is-maximized",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "opener:default",
    "process:default",
    "clipboard-manager:default",
    "shell:allow-open"
  ]
}
