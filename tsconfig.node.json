{
  "include": [
    "vite.config.ts",
    "scripts/**/*",
    "src/main/**/*",
    "src/sidecar/**/*",
    "src/shared/**/*",
    "src/renderer/src/types.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@main/*": [
        "src/main/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "electron": [
        "src/sidecar/electron-shim.ts"
      ],
      "electron-log": [
        "src/sidecar/shims/electron-log.ts"
      ],
      "electron-updater": [
        "src/sidecar/shims/electron-updater.ts"
      ]
    },
    "noImplicitAny": false
  }
}
