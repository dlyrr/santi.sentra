ion History\",\n ",[2094,2146],"{ details: \"Reading Logs\", ",[2181,2229],"{ details: \"Configuring Settings\", ",[2266,2316],"{ details: \"Customizing Avatar\", ",[2353,2401],"{ details: \"Managing Installations\",",[2438,2490],"{ details: \"Reading the News\", ",[2532,2595],"\n    details: \"Tweaking Account Settings\",\n    state: \"Account Config\",\n ",[2610,2659],"{ details: \"Watching Sessions\", ",[2697,2747],"{ details: \"Sniping Usernames\", ",[2785,2835],"{ details: \"Managing Trades\", ",[2874,2921],"{ details: \"Viewing Analytics\", ",[2966,3013],"{ details: \"Generating Accounts\", ",[3054,3103],"{ details: \"Managing Backups\", ",[3140,3190],"{ details: \"Browsing the Market\", ",[3228,3278]," { details: \"Getting Support\", ",[3311,3362],"{ details: \"Debugging the App\", ",[3388,3389],[5336,5357]," \"playing\", \"accounts\", ",[7008,7075],"\n      clearTimeout(this.reconnectTimeout);\n      this.reconnectTimeout = null;\n   ",[7107,7168],"\n      clearTimeout(this.updateTimeout);\n      this.updateTimeout = null;\n   ",[7500,7567],[7599,7660],[9690,9691],[9912,9965],"\n    name: string;\n    placeId: string;\n    thumbnailUrl?: string;\n ",[11214,11260],"\n            accountCount === 1\n              ? \"Playing with 1 account\"\n             ",[11574,11574],"\n           ",[11592,11592],"  ",[11641,11641],[12345,12346],[12552,12552],[12690,12732],"\n            accountCount === 1\n              ? \"Managing 1 account\"\n             ",[13092,13092],[14211,14234],"\n    return this.isEnabled;\n ",[14275,14299],"\n    return this.statusMode;\n ",[14342,14372],"\n    return this.customStatusText;\n ",{"messageId":"3590","data":"3591","fix":"3592","desc":"3593"},[7613,7640],"const rap = itemData[2] || 0;",{"messageId":"3594","fix":"3595","desc":"3596"},{"messageId":"3597","fix":"3598","desc":"3599"},[933,956],[9445,9474],"const allPresences: any[] = [];",[101,146],"\n  \"full\",\n  \"playing\",\n  \"accounts\",\n  \"minimal\",\n]);",[1012,1069],"\n  