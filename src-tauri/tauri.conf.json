{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "santi.manager",
  "mainBinaryName": "santi.manager",
  "version": "1.2.1",
  "identifier": "com.sentra.app",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "santi.manager",
        "width": 1400,
        "height": 900,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#111111",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "script-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/lists/roblox_items.db": "assets/lists/roblox_items.db",
      "../assets/icons": "assets/icons",
      "binaries/sidecar.cjs": "sidecar.cjs",
      "binaries/node_modules": "node_modules"
    },
    "externalBin": [
      "binaries/santi.manager-sidecar"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "santi.manager"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMUU3QjI2OUI1Mzk3NzkKUldSNWwxT2JKbnNlWHRzQTFEcVpIaCt6RktLY2owWXl4NHp5YXNwbzcwQjVuT3p3YVVkUkRKNFkK",
      "endpoints": [
        "https://github.com/dlyrr/santi.sentra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
